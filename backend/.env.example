# Voxxstake Backend Environment Variables
# Copy this file to .env and fill in your values.
# WARNING: never commit .env with real secrets!

# MongoDB connection string
MONGO_URL=mongodb://localhost:27017
DB_NAME=voxxstake

# CORS: comma-separated list of allowed origins.
# In production, set this to your frontend domain (e.g. https://voxxstake.up.railway.app).
# Leave empty and CORS will be disabled in production (most restrictive).
CORS_ORIGINS=http://localhost:3000

# Sui data access. Use a production-grade provider URL on Railway; Foundation
# public endpoints are rate-limited and intended for development.
SUI_NETWORK=mainnet
SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443
# Comma-separated gRPC backup URLs (optional)
SUI_GRPC_FAILOVER=
# Per-endpoint gRPC timeout in milliseconds (default: 15000)
SUI_GRPC_TIMEOUT_MS=15000
# Used only for zkLogin signature verification
SUI_GRAPHQL_URL=https://graphql.mainnet.sui.io/graphql

# JWT secret: MUST be a strong random string in production.
# The server will refuse to start in production if this is unset.
JWT_SECRET=change-me-in-production

# Server port
PORT=8001

# Admin addresses: comma-separated Sui wallet addresses that can access /api/admin
# Example: ADMIN_ADDRESSES=0x1234...,0x5678...
ADMIN_ADDRESSES=

# Rate limiting: minimum seconds between sync calls per address (default: 60)
SYNC_RATE_LIMIT_SEC=60
